# llama.cpp server connection (OpenAI-compatible /v1/ API)
LLAMA_HOST=http://127.0.0.1:8012

# Optional: hard-pin which model to use for each role.
# Leave blank to let ModelManager auto-pick from /v1/models.
LLAMA_DEVELOPER_MODEL=
LLAMA_REVIEWER_MODEL=
LLAMA_SECURITY_MODEL=
LLAMA_VALIDATOR_MODEL=

# Seconds before an LLM call times out
LLAMA_TIMEOUT=120

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
